# Server
PORT=3000
APP_BASE_URL=http://localhost:3000

# Email (SMTP) — required for parent verification and escalation emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Escalation — overdue complaints are emailed to this address
ESCALATION_EMAIL=warden@yourhostel.com

# Twilio (optional) — uncomment server.js callService block to enable real IVR calls
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1234567890
